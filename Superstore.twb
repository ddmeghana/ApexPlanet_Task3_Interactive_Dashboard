      <aliases enabled='yes' />
      <column caption='Average Order Value' datatype='real' name='[Calculation_1239897272932999168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order_ID])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_1239897272933666817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order_ID])' />
      </column>
      <column caption='Discount band' datatype='string' name='[Calculation_1239897272938950658]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;No Discount&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.2 THEN &quot;Low Discount&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.5 THEN &quot;Medium Discount&quot;&#13;&#10;ELSE &quot;High Discount&quot;&#13;&#10;END' />
      </column>
